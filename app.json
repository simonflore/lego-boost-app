{
  "expo": {
    "name": "Boost Control",
    "slug": "lego-boost-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "legoboost",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legoboost.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Boost Control uses Bluetooth to connect to and control your BOOST Move Hub.",
        "UIBackgroundModes": [
          "bluetooth-central"
        ],
        "GCSupportedGameControllers": [
          {
            "ProfileName": "ExtendedGamepad"
          }
        ],
        "GCSupportsControllerUserInteraction": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.legoboost.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Boost Control",
      "shortName": "Boost Control",
      "themeColor": "#E3000B",
      "backgroundColor": "#F6F4EF"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Boost Control uses Bluetooth to connect to and control your BOOST Move Hub."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    },
    "extra": {
      "eas": {
        "projectId": "dee5c6a7-28e5-42df-9585-291db22213df"
      }
    }
  }
}
